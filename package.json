{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "notakrista.com",
    "type": "module",
    "private": true,
    "author": "Jorge Thomas (akrista) <info@notakrista.com> (https://notakrista.com/)",
    "license": "MIT",
    "licenseUrl": "http://github.com/akrista/notakrista.com",
    "homepage": "https://github.com/akrista/notakrista.com",
    "bugs": {
        "url": "https://github.com/akrista/notakrista.com/issues"
    },
    "keywords": [
        "filamentphp",
        "laravel",
        "typescript",
        "vite"
    ],
    "scripts": {
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr resources/js/ssr.tsx && vite build --ssr resources/js/ssr-vue.ts && vite build --ssr resources/js/ssr-svelte.ts",
        "dev": "vite",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "types:check": "tsc --noEmit && vue-tsc --noEmit && svelte-check --tsconfig ./tsconfig.json"
    },
    "dependencies": {
        "@emnapi/core": "1.9.1",
        "@emnapi/runtime": "1.9.1",
        "@inertiajs/react": "^3.0.3",
        "@inertiajs/svelte": "^3.0.3",
        "@inertiajs/vue3": "^3.0.3",
        "@sveltejs/vite-plugin-svelte": "^7.0.0",
        "@tailwindcss/vite": "^4.2.4",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.1",
        "@vitejs/plugin-vue": "^6.0.6",
        "@vueuse/core": "^14.2.1",
        "autoprefixer": "^10.5.0",
        "axios": "^1.15.2",
        "blade-islands": "^0.1.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "concurrently": "^9.2.1",
        "driver.js": "^1.4.0",
        "globals": "^17.5.0",
        "laravel-echo": "^2.3.4",
        "laravel-vite-plugin": "^3.1.0",
        "pusher-js": "^8.5.0",
        "react": "^19.2.5",
        "react-dom": "^19.2.5",
        "svelte": "^5.55.5",
        "tailwind-merge": "^3.5.0",
        "tailwindcss": "^4.2.4",
        "typescript": "^6.0.3",
        "vite": "^8.0.10",
        "vue": "^3.5.33"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@laravel/vite-plugin-wayfinder": "^0.1.7",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": "^25.6.0",
        "@vue/eslint-config-typescript": "^14.7.0",
        "babel-plugin-react-compiler": "^1.0.0",
        "eslint": "^9.39.4",
        "eslint-config-prettier": "^9.1.2",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-svelte": "^3.17.1",
        "eslint-plugin-vue": "^9.33.0",
        "npm-check-updates": "^19.6.6",
        "playwright": "^1.59.1",
        "prettier": "^3.8.3",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-svelte": "^3.5.1",
        "prettier-plugin-tailwindcss": "^0.7.4",
        "svelte-check": "^4.4.6",
        "typescript-eslint": "^8.59.1",
        "vue-tsc": "^3.2.7"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.60.1",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.2.4",
        "lightningcss-linux-x64-gnu": "^1.32.0"
    }
}
