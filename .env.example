APP_NAME=notakrista.com
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_PORT=8000
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Caracas
# ASSET_URL="/" # TODO
VITE_APP_NAME="${APP_NAME}"

API_VERSION_STRATEGY=uri
API_VERSION="1.0.0"
API_DEFAULT_VERSION=latest
API_VERSION_TRACKING=false
API_RATE_LIMIT=60
API_DOCS_URL=http://localhost:8080/docs/api
API_KEY="your-secret-api-key-here"
SMS_API_URL=https://api.localhost.example.com
SMS_API_USER=username
SMS_API_PASSWORD="your-secret-api-key-here"
METABASE_URL=https://metabase.notakrista.com
METABASE_SECRET_KEY=
METABASE_TOKEN_EXPIRATION=600

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

WITH_SCHEDULER=false
WITH_HORIZON=false #! Needs Redis
WITH_REVERB=false
WITH_WORKER=false
WORKER_COMMAND="php artisan queue:work"

PANEL_ROUTE=admin #! use only minuscules

ONLY_FILAMENT=false
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE="0000-0000000"
ADMIN_USER=admin
ADMIN_PASSWORD=admin

TOP_NAV_ENABLED=false
TOPBAR_ENABLED=true

OCTANE_SERVER=swoole
OCTANE_HTTPS=false
SWOOLE_WORKERS=16

HASH_DRIVER=argon2id

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily,errorlog
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite #? sqlite,mysql,pgsql,mariadb,sqlsrv
# DB_HOST=127.0.0.1
# DB_PORT=5432 #? 3306,5432,1433
DB_DATABASE=./storage/sqlite/notakrista.sqlite #! must be a path if sqlite
# DB_SCHEMA=public #! for postgres
# DB_USERNAME=root
# DB_PASSWORD=
# DB_ENCRYPT=yes #! for sqlsrv
# DB_TRUST_SERVER_CERTIFICATE=true #! for sqlsrv

SESSION_DRIVER=database #? file, cookie, database, memcached, redis, dynamodb, array
SESSION_CONNECTION="${DB_CONNECTION}" #? redis
SESSION_TABLE=sessions
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log #? reverb, pusher, ably, redis, log, null
FILESYSTEM_DISK=local #? s3
QUEUE_CONNECTION=database #? redis

CACHE_STORE=failover #? file, cookie, database, memcached, redis, dynamodb, array, octane
# CACHE_PREFIX="${APP_NAME}_"

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT= #? endpoint must point to 9000 port
AWS_URL=${AWS_ENDPOINT}/${AWS_BUCKET}/

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SERVER_HOST="localhost"
REVERB_SERVER_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

ANTHROPIC_API_KEY=
COHERE_API_KEY=
ELEVENLABS_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
OLLAMA_API_KEY=
OPENAI_API_KEY=
JINA_API_KEY=
VOYAGEAI_API_KEY=
XAI_API_KEY=

GITHUB_TOKEN=
SMART_CACHE_DASHBOARD=true
